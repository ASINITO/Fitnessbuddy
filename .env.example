# FitBuddy Environment Configuration
# Copy this file to .env and configure your secrets

# Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Secrets & Security
SECRET_KEY=fitbuddy_super_secret_session_key_change_in_production_2026
