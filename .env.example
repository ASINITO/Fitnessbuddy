ADMIN_PASSWORD=change_this_admin_password_123

# Database configuration (SQLite default)
DATABASE_URL=sqlite:///./fitbuddy.db

# Server settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
